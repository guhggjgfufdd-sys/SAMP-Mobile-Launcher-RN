<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="seekArcStyle" format="reference" />
    <declare-styleable name="MKLoader">
        <attr name="mk_color" format="color" />
        <attr name="mk_type" format="string" />
    </declare-styleable>
    <declare-styleable name="SeekArc">
        <attr name="thumb" format="reference" />
        <attr name="arcWidth" format="dimension" />
        <attr name="startAngle" format="integer" />
        <attr name="sweepAngle" format="integer" />
        <attr name="rotation" format="integer" />
        <attr name="roundEdges" format="boolean" />
        <attr name="clockwise" format="boolean" />
        <attr name="progress" format="integer" />
        <attr name="arcColor" format="color" />
        <attr name="progressColor" format="color" />
        <attr name="touchInside" format="boolean" />
        <attr name="enabled" format="boolean" />
        <attr name="progressWidth" format="dimension" />
        <attr name="max" format="integer" />
    </declare-styleable>
    <declare-styleable name="MaskedEditText">
        <attr name="mask" format="string" />
        <attr name="allowed_chars" format="string" />
        <attr name="denied_chars" format="string" />
        <attr name="char_representation" format="string" />
        <attr name="keep_hint" format="boolean" />
    </declare-styleable>
</resources>
